# ==============================================================================
# Autonomous Multi-Agent Framework for Fraud & Cyber Threat Detection
# Environment Configuration Template
# ==============================================================================

# LLM Provider Selection: "gemini", "groq", "ollama", "openai", or "mock"
# Default is "mock" for instant offline testing without any API keys.
LLM_PROVIDER=mock

# 1. Google Gemini API (Recommended for free cloud tier)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud (Ultra-fast inference, free tier available)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Local Ollama (100% offline, privacy-first)
# Download from: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# 4. OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Detection & Agent Configuration
TIER1_ANOMALY_THRESHOLD=0.55
AGENT_CONSENSUS_THRESHOLD=0.70
ENABLE_DEBATE_ROUND=true
MAX_DEBATE_ROUNDS=2

# 5. SOC Private Access Credentials (Restricted Owner Access)
# Protects the interactive dashboard; allows login via Gmail OR Mobile Number + Password
SOC_OWNER_NAME="Hemanth Gowda T"
SOC_OWNER_GMAIL="hemanthhemu6557@gmail.com"
SOC_OWNER_MOBILE="+919886966865"
SOC_OWNER_PASSWORD="Hemanth@6557"

# 6. Real OTP Delivery (Gmail SMTP & SMS Gateway)
# Generate a 16-character Google App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hemanthhemu6557@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# Fast2SMS (Free Tier for Indian Mobile Numbers: https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
